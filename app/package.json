{
  "name": "@garden-planner/app",
  "version": "0.0.0",
  "private": true,
  "description": "The React + Vite front-end. The only workspace deployed to GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "smoke:deployed": "playwright test --config=playwright.pages.config.ts",
    "a11y": "playwright test --config=playwright.a11y.config.ts",
    "keyboard-walkthrough": "node keyboard-walkthrough.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@garden-planner/engine": "*",
    "konva": "^9.3.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.10",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
